{
  "name": "pi-hindsight-memory",
  "version": "0.8.0",
  "description": "Global, provenance-preserving memory for Pi backed by Hindsight.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-hindsight-memory": "dist/src/importer/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/extension/index.js"
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "lint:shell": "shellcheck --external-sources scripts/*.sh scripts/lib/*.sh",
    "deps:check": "npm ls --all > /dev/null && knip --treat-config-hints-as-errors && knip --include cycles",
    "deps:audit": "npm audit --audit-level=low",
    "check:docs": "node scripts/checks/docs.mjs",
    "check:package": "node scripts/checks/package.mjs",
    "validate": "npm run check && npm run lint && npm run lint:shell && npm run deps:check && npm run check:docs && npm test && npm run check:package",
    "release:check": "npm run validate && npm run deps:audit",
    "test": "npm run build && node --import ./scripts/checks/test-telemetry.mjs --test dist/test/unit/*.test.js dist/test/integration/*.test.js && npm run test:publisher",
    "test:publisher": "python3 -W error::ResourceWarning -m unittest discover -s test/publisher",
    "test:unit": "npm run build && node --import ./scripts/checks/test-telemetry.mjs --test dist/test/unit/*.test.js",
    "inventory": "node dist/src/importer/cli.js inventory",
    "doctor": "node dist/src/importer/cli.js doctor",
    "prepare": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.10.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenworr/pi-hindsight-memory.git"
  },
  "homepage": "https://github.com/zenworr/pi-hindsight-memory#readme",
  "bugs": {
    "url": "https://github.com/zenworr/pi-hindsight-memory/issues"
  },
  "license": "MIT",
  "files": [
    "dist/src",
    "deploy/compose/bank-config.json",
    "deploy/compose/bank-config.no-llm.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "hindsight",
    "memory",
    "coding-agent"
  ]
}
